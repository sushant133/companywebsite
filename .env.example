# Copy this file to .env.local and fill it in. Restart `npm run dev` after any change.
# .env.local is git-ignored — never commit real credentials.

# ---------------------------------------------------------------- database ---
# MongoDB Atlas connection string. Without it the public site still renders from
# its built-in defaults, but the admin dashboard cannot be used at all.
# In Atlas: Database > Connect > Drivers, then allow this machine's IP under
# Network Access.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Database to use inside that cluster.
MONGODB_DB="mantrasphere"

# ------------------------------------------------------------------- auth ---
# Signing key for the admin session cookie. At least 32 characters, random, and
# different in every environment. Changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Optional. When set, this value must also be typed into the first-run form
# before the first owner account can be created — worth setting in production so
# the window between deploying and claiming the dashboard is not open to anyone.
ADMIN_SETUP_TOKEN=""

# ------------------------------------------------------------------- mail ---
# SMTP account used for contact-form notifications and bulk campaigns. Leave
# these empty to run without mail: the contact form then falls back to Formspree
# and the Bulk email screen tells you it is not configured.
# For Gmail/Workspace use an App Password, not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" only for implicit TLS on port 465
SMTP_USER="you@example.com"
SMTP_PASSWORD=""
SMTP_FROM="MantraSphere <you@example.com>"
SMTP_REPLY_TO=""             # optional; defaults to the site contact address

# --------------------------------------------------------------- fallback ---
# Formspree endpoint the contact form posts to when SMTP is not configured.
FORMSPREE_ENDPOINT="https://formspree.io/f/mgonlrqe"
